<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hexagon.desk</string>

  <!-- Run through ops/run-desk.sh rather than calling node directly. launchd hands jobs a minimal
       PATH that does not include nvm, so `/usr/bin/env node` exits 127 and the job silently never
       starts. The launcher finds node the way a login shell would. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HEXDIR__/ops/run-desk.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HEXDIR__</string>

  <!-- Start at login and restart if it ever exits. A week of paper evidence is only worth
       collecting if the process actually survives a week, and a nohup'd shell job does not
       survive a reboot -- which is how a week of measurement quietly becomes an afternoon
       of it. Paper mode only; install-autostart.sh refuses to install this if MODE=live. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>__HEXDIR__/data/desk.log</string>
  <key>StandardErrorPath</key>
  <string>__HEXDIR__/data/desk.log</string>
</dict>
</plist>
