{
  "ui": [
    "public/"
  ],
  "ignore": [
    "public/vendor/lightweight-charts.standalone.production.js"
  ],
  "protect": [
    "ops/design-gate.json",
    "ops/design-gate.mjs",
    ".github/workflows/test.yml"
  ],
  "checks": [
    "impeccable-audit",
    "impeccable-critique",
    "unslop-audit",
    "break-ui",
    "phone-audit",
    "blind-read"
  ],
  "phoneAudit": true,
  "phoneAuditSet": [
    "375 light 44",
    "375 dark 44",
    "440 light 44",
    "440 dark 44",
    "440 light 24"
  ],
  "phoneAuditUrls": "tools/phone-audit-urls.txt",
  "phoneAuditBroken": "^(STATUS|EVAL|NOSHEET|SHEET-NOT-OPEN|NO-FRAME)\\b",
  "render": {
    "start": "DEMO=1 DATA_DIR=\"$GATE_DATA\" PORT=\"$GATE_PORT\" exec node server.js",
    "ready": "/",
    "settle": 12,
    "audit": "node tools/phone-audit.mjs \"$GATE_URL\" \"$GATE_OUT\" \"$GATE_URLS\" \"$GATE_WIDTH\" \"$GATE_SCHEME\"",
    "auditEnv": {
      "SHOTS": "1",
      "FULL": "1"
    },
    "views": "#today",
    "desktopReady": "!!document.getElementById(\"floor\") && !document.getElementById(\"floor\").hasAttribute(\"aria-busy\")"
  }
}
