<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hexagon.pull</string>

  <!-- Through ops/run-pull.sh rather than node directly: launchd's PATH has neither nvm's node
       nor ~/.fly/bin/fly, and a job that cannot find them exits 127 without anyone noticing.
       No WorkingDirectory on purpose: run-pull.sh cds itself, and a checkout that has moved then
       fails with a readable "No such file" in the log below instead of launchd refusing to start. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HEXDIR__/ops/run-pull.sh</string>
  </array>

  <!-- Every hour at :30. ops/run-pull.sh exits at once, writing nothing, when pull.log and
       backup.log already have an ok line dated today (Eastern), so a good day costs one real run
       and the other slots are free retries. Until 2026-09-24 there were two slots, 09:30 and 13:30,
       and 9 of the 21 runs from 09-15 failed: launchd starts a slot the Mac slept through in the next
       brief battery DarkWake, the Mac falls back asleep within seconds, and the frozen run times out
       hours later. launchd never starts a second copy while one is still running. If the Mac is
       switched off, the slots are skipped; the box has about two weeks of room, and its own brake
       after that. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <!-- Not at login, and not kept alive: this is a daily chore, not a server. -->
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>

  <!-- ~/Library/Logs always exists. launchd will not create a log's folder, and a log path inside
       the checkout would stop the job from starting at all -- silently -- the day that folder is
       moved or deleted. data/fly/archive/pull.log still gets one summary line per run. -->
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/hexagon-pull.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/hexagon-pull.log</string>
</dict>
</plist>
