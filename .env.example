# ---- The Hexagon configuration (copy to .env) ----

# paper | live   (live requires the two Kalshi keys below AND LIVE_CONFIRM)
MODE=paper

# Set to 1 to inject synthetic price noise into Kalshi quotes so you can watch
# the desk trade while testing the UI. Never combine with MODE=live (refused).
DEMO=0

PORT=8787
INITIAL_BALANCE=10000

# ---- risk (TESS enforces) ----
MAX_POSITION_PCT=0.02          # max notional per position as a fraction of equity
MAX_OPEN_POSITIONS=12
MAX_DAILY_DRAWDOWN_PCT=0.03    # halt for the day past this loss from day-start equity
MAX_DATA_AGE_SEC=90            # halt if quotes are older than this

# ---- strategy (BRAM signals, RIGO exits) ----
MIN_ARB_EDGE=0.01              # locked cross-venue arb: min net edge per $1 contract
MIN_GAP=0.03                   # convergence trade: min venue disagreement (mid vs mid)
MIN_EDGE=0.005                 # convergence trade: min profit/contract vs fair value, NET of the
                               #   exit spread and a taker fee on BOTH sides. Keep well under
                               #   MIN_GAP -- fair value sits between the venues, so the
                               #   realisable edge is only ever a fraction of the gap.
EXIT_GAP=0.01                  # convergence trade: close when gap narrows to this
STOP_LOSS=0.06                 # convergence trade: close if mark falls this far below entry
MAX_HOLD_MIN=240               # convergence trade: close after this many minutes

# ---- tick recorder ----
RECORD=1                       # 1 = append every priced pair, every cycle, to
                               #   DATA_DIR/ticks-YYYY-MM-DD.jsonl (Eastern day). 0 = off.
                               #   Append-only and best-effort: a failed write is logged and the
                               #   cycle continues. Roughly 35 MB/day at 20 pairs; nothing prunes it.
PROBE_GAP=0.03                 # when the venues disagree by this much, dump BOTH full order books
                               # (= MIN_GAP: under it no trade is possible, so there is nothing to validate)
                               #   to DATA_DIR/probes-YYYY-MM-DD.jsonl. A gap this wide is either a
                               #   real opportunity or a price with no size behind it, and only the
                               #   book tells them apart. Read-only: probing never trades.
PROBE_EVERY_SEC=600            # per-pair cooldown, so one wide pair cannot spam the probe
PROBES_PER_CYCLE=2             # cap on extra API calls per cycle

# ---- serving ----
BIND_HOST=127.0.0.1            # loopback only. /api/positions and the activity log are
                               #   unauthenticated; 0.0.0.0 exposes them to your whole network.
FLATTEN_TOKEN=                 # shared secret for the manual kill switch. Empty = disabled.
                               #   With one set:  curl -XPOST -H "x-flatten-token: <token>" \
                               #                    http://127.0.0.1:8787/api/flatten
                               #   Closes EVERY open position at the mark. A drawdown halt stops
                               #   new risk but leaves existing positions running; this is flat.

# ---- fees ----
PM_TAKER_FEE=0                 # Polymarket taker fee per $ notional (most markets are 0)
KS_FEE_RATE=0.07               # Kalshi fee = ceil(rate * contracts * P * (1-P))

# ---- maker tape ----
MAKER_STREAM=1                 # 1 = read the exchange-wide trade tape over Kalshi's WebSocket
                               #   trade channel (needs the key below: the handshake is signed).
                               #   The 2s poll stays as the fallback and runs for any interval the
                               #   socket cannot vouch for. 0 = poll only. No key = poll only.
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2

# ---- whale watch (src/whales.js) ----
# ILSA calls out big bets by the top Polymarket sports wallets. Public data, no key, never trades.
# tools/whale-lab.js found copying them does not pay out of sample; see README.
WHALE_WATCH=1                  # 0 = off
WHALE_TOP=25                   # wallets followed, by profit on the sports leaderboard
WHALE_PERIOD=MONTH             # DAY | WEEK | MONTH | ALL
WHALE_MIN_USD=10000            # net buying on one outcome within WHALE_WINDOW_MIN that counts as a bet
WHALE_WINDOW_MIN=360

# ---- the minds (src/brain.js, src/minds.js) ----
# The seven desks reason with Claude. Everything here is optional: with no key the desks fall
# back to the deterministic path in src/decide.js, which is a complete trading system on its own.
#
# Turns are EVENT-DRIVEN, not scheduled. There is deliberately no "every N seconds" knob: a desk
# reasons when its board changes in a way worth paying to read, and is free when nothing happens.
# Measured: a turn on a scheduled cadence costs ~$380/day PER DESK at a 15s cycle. Don't.
ANTHROPIC_API_KEY=             # https://platform.claude.com/ -> API keys. Starts sk-ant-api03-...
                               #   Never commit this. .env is gitignored; keep it that way.
BRAIN=1                        # 0 = deterministic desks only, no API calls, no spend.
BRAIN_DAILY_USD=1              # HARD CEILING per Eastern day. On reaching it the brain stops
                               #   calling entirely and every desk falls back to deterministic
                               #   logic -- the desk keeps trading, it just stops reasoning.
                               #   This is a rail, not a budget: the failure mode it exists for is
                               #   a stuck trigger firing every cycle, not a slow overspend.
BRAIN_MODEL_DEEP=claude-opus-5    # BRAM and KETT: the desks whose turns decide if money moves.
BRAIN_MODEL_FAST=claude-sonnet-5  # everyone else: noticing and summarising. ~2.5x cheaper.
BRAIN_DEEP_AGENTS=BRAM,KETT    # which desks get the deep model.
BRAIN_EFFORT=medium            # low | medium | high | xhigh | max. Thinking depth and spend.
BRAIN_MIN_GAP_SEC=45           # floor between two turns for one desk, whatever its trigger says.
                               #   Stops a flapping quote from re-buying the same judgement.
BRAIN_TIMEOUT_MS=90000         # a turn takes 7-24s; this is the give-up point.
BRAIN_PAIRS=12                 # max pairs per view. Only pairs above MIN_GAP are ever included.
LLM_MIN_EDGE=0                 # floor under a mind-originated trade, in dollars per contract.
                               #   `edge` is already net of both spreads and BOTH taker fees, so 0
                               #   is exact break-even. A desk may argue for a thin trade on a
                               #   thesis; it may not take one that is certain to lose.
REENTRY_COOLDOWN_MIN=10        # a pair is untouchable for this long after an exit, minds included.

# ---- the Ask panel (src/ask.js) ----
# Type a question on the dashboard; Claude answers from read-only views of the desk. It cannot
# trade or change anything. Needs ANTHROPIC_API_KEY above, and spends only when someone asks.
ASK=1                          # 0 = panel off.
ASK_MODEL=claude-opus-5
ASK_EFFORT=medium              # low | medium | high | xhigh | max.
ASK_DAILY_USD=3                # HARD CEILING per Eastern day for questions, separate from BRAIN_DAILY_USD.
ASK_MAX_ROUNDS=8               # tool rounds per question before it must answer with what it has.
ASK_TIMEOUT_MS=120000          # per API call.

# ---- Kalshi key ----
# Signs live orders in MODE=live, and -- in any mode, if set -- the handshake for the read-only
# market-data socket above. Polymarket live execution is not implemented.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi-private-key.pem
# You must type this exact phrase to start in live mode:
LIVE_CONFIRM=
