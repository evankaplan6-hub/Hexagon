# ---- The Hexagon configuration (copy to .env) ----

# paper | live   (live requires the two Kalshi keys below AND LIVE_CONFIRM)
MODE=paper

# Set to 1 to inject synthetic price noise into Kalshi quotes so you can watch
# the desk trade while testing the UI. Never combine with MODE=live (refused).
DEMO=0

PORT=8787
INITIAL_BALANCE=10000

# ---- risk (TESS enforces) ----
MAX_POSITION_PCT=0.02          # max notional per position as a fraction of equity
MAX_OPEN_POSITIONS=12
MAX_DAILY_DRAWDOWN_PCT=0.03    # halt for the day past this loss from day-start equity
MAX_DATA_AGE_SEC=90            # halt if quotes are older than this

# ---- strategy (BRAM signals, RIGO exits) ----
MIN_ARB_EDGE=0.01              # locked cross-venue arb: min net edge per $1 contract
MIN_GAP=0.03                   # convergence trade: min venue disagreement (mid vs mid)
MIN_EDGE=0.005                 # convergence trade: min profit/contract vs fair value, NET of the
                               #   exit spread and a taker fee on BOTH sides. Keep well under
                               #   MIN_GAP -- fair value sits between the venues, so the
                               #   realisable edge is only ever a fraction of the gap.
EXIT_GAP=0.01                  # convergence trade: close when gap narrows to this
STOP_LOSS=0.06                 # convergence trade: close if mark falls this far below entry
MAX_HOLD_MIN=240               # convergence trade: close after this many minutes

# ---- tick recorder ----
RECORD=1                       # 1 = append every priced pair, every cycle, to
                               #   DATA_DIR/ticks-YYYY-MM-DD.jsonl (Eastern day). 0 = off.
                               #   Append-only and best-effort: a failed write is logged and the
                               #   cycle continues. Roughly 60-80 MB/day; nothing prunes it.

# ---- fees ----
PM_TAKER_FEE=0                 # Polymarket taker fee per $ notional (most markets are 0)
KS_FEE_RATE=0.07               # Kalshi fee = ceil(rate * contracts * P * (1-P))

# ---- live trading (Kalshi only; Polymarket live execution is not implemented) ----
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi-private-key.pem
# You must type this exact phrase to start in live mode:
LIVE_CONFIRM=
